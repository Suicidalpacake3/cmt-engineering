# CMT Engineering: Apache settings (cPanel and most shared hosts)

ErrorDocument 404 /404.html
DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force https and drop www
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# Old WordPress addresses keep working (NE keeps the #anchor intact)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^activities/ht-lt-electrical-services/?$ /our-services/#ht-lt-electrical [NE,R=301,L]
  RewriteRule ^activities/borehole-testing-water-treatment-plants/?$ /our-services/#borehole-testing [NE,R=301,L]
  RewriteRule ^activities/environmental-solutions/?$ /our-services/#environmental-solutions [NE,R=301,L]
  RewriteRule ^activities/mobile-diesel-pumps-diesel-generators/?$ /our-services/#diesel-pumps-generators [NE,R=301,L]
  RewriteRule ^activities/sibanye-stillwater/?$ /our-projects/#sibanye-stillwater [NE,R=301,L]
  RewriteRule ^activities/glencore/?$ /our-projects/#glencore [NE,R=301,L]
  RewriteRule ^activities/goldfields/?$ /our-projects/#goldfields [NE,R=301,L]
  RewriteRule ^activities/siyanda-bakgatla-platinum-mine-swartklip/?$ /our-projects/#siyanda-bakgatla [NE,R=301,L]
  RewriteRule ^activities/drd-gold-ergo-brakpan-east-rand/?$ /our-projects/#drd-gold-ergo [NE,R=301,L]
  RewriteRule ^activities/rhovan-vanadium-mine-bethanie-rustenburg/?$ /our-projects/#glencore [NE,R=301,L]
  RewriteRule ^activities/jaguar-mining-brazil/?$ /our-projects/#project-index [NE,R=301,L]
  RewriteRule ^activities/circum-minerals-ethiopia-danakil-dessert/?$ /our-projects/#project-index [NE,R=301,L]
  RewriteRule ^activities/debswana-botswana-orapa/?$ /our-projects/#project-index [NE,R=301,L]
  RewriteRule ^activities/sylvania-lesedi-plant/?$ /our-projects/#project-index [NE,R=301,L]
  RewriteRule ^activities/?$ /our-projects/ [NE,R=301,L]
  RewriteRule ^portfolio_category/products-services/?$ /our-services/ [NE,R=301,L]
  RewriteRule ^portfolio_category/projects/?$ /our-projects/ [NE,R=301,L]
  RewriteRule ^wp-content/uploads/2022/08/CMT-Engineering-Company-Profile\.pdf/?$ /assets/docs/CMT-Engineering-Company-Profile.pdf [NE,R=301,L]
  RewriteRule ^(wp-admin|wp-login\.php|feed|comments/feed|author/.*)/?$ / [NE,R=301,L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/x-icon "access plus 6 months"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType application/pdf "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
